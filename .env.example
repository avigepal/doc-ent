# --- Postgres ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
# HOST_DATA_DIR: where the data lives on THIS machine (docker-compose.yml
# bind-mounts it in). Point it at an existing corpus location, or leave
# the default to use ./data under the repo.
HOST_DATA_DIR=./data
# DATA_DIR: the path the app sees INSIDE every container. Always
# /data/pipeline — don't change this one, it must match docker-compose.yml's
# mount target.
DATA_DIR=/data/pipeline

# How often (seconds) auto-ingest scans raw/, enqueues conversion, and
# enqueues summarization on its own — no manual /ingest/* calls needed.
# Set to 0 to disable the periodic schedule (manual calls still work).
AUTO_INGEST_INTERVAL_SECONDS=60

# --- API auth ---
BEARER_TOKEN=change-me-to-a-long-random-token

# --- llama.cpp servers (filled in once models are downloaded/quantized — phase 3/4) ---
LLAMA_TEXT_URL=http://llama-text:8080
LLAMA_VISION_URL=http://llama-vision:8080
LLAMA_EMBED_URL=http://llama-embed:8080
