# --- Postgres ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
# HOST_DATA_DIR: where the data lives on THIS machine (docker-compose.yml
# bind-mounts it in). Point it at an existing corpus location, or leave
# the default to use ./data under the repo.
HOST_DATA_DIR=./data
# DATA_DIR: the path the app sees INSIDE every container. Always
# /data/pipeline — don't change this one, it must match docker-compose.yml's
# mount target.
DATA_DIR=/data/pipeline

# How often (seconds) auto-ingest scans raw/, enqueues conversion, and
# enqueues summarization on its own — no manual /ingest/* calls needed.
# Set to 0 to disable the periodic schedule (manual calls still work).
AUTO_INGEST_INTERVAL_SECONDS=60

# Summarize every file during auto-ingest? Summaries are many sequential LLM
# calls per file (hours for a big batch) and search doesn't need them. Set
# false to stop after convert + index; "Summarize" in the API still works.
AUTO_SUMMARIZE=true

# Docling (PDF/Office conversion) speed knobs. Defaults = Docling's own.
# DOCLING_OCR=false skips OCR on images/scans (scanned pages get no text);
# DOCLING_TABLES=false skips table recognition (tables become plain text);
# DOCLING_PAGE_BATCH_SIZE = pages the models process at once (0 = default 4);
# raise it (8, 16) to keep the GPU busier, as far as VRAM allows.
DOCLING_OCR=true
DOCLING_TABLES=true
DOCLING_TABLE_MODE=fast
DOCLING_PAGE_BATCH_SIZE=0

# Chunks per embedding request while indexing (try 32).
EMBED_BATCH_SIZE=16

# Seconds before a file already queued for a stage may be queued again.
QUEUE_DEDUPE_SECONDS=1800

# --- API auth ---
BEARER_TOKEN=change-me-to-a-long-random-token

# --- LLM endpoints ---
# Point these at a local llama-server (docker-compose.yml's commented-out
# llama-* services), an Ollama server, OR any remote OpenAI-compatible
# endpoint — same base_url/api_key/model shape either way.
#
# For Ollama: it's one server on one port serving every model (routed by
# the model name in the request body, not by port), so all three URLs
# below point at the SAME host:port and only *_MODEL differs. Start it
# with OLLAMA_MAX_LOADED_MODELS=3 OLLAMA_NUM_PARALLEL=2
# OLLAMA_HOST=0.0.0.0:11434 so it keeps all three models loaded at once
# and is reachable from outside localhost.
LLAMA_TEXT_URL=http://llama-text:8080
LLAMA_VISION_URL=http://llama-vision:8080
LLAMA_EMBED_URL=http://llama-embed:8080

# Leave empty for a local llama-server or Ollama (neither requires auth by
# default). Set these when LLAMA_*_URL points at a remote endpoint that
# requires a bearer token.
LLAMA_TEXT_API_KEY=
LLAMA_VISION_API_KEY=
LLAMA_EMBED_API_KEY=

# "local" works for llama-server. Ollama and remote providers expect a
# real model name/id instead (e.g. `ollama ls`'s NAME column).
LLAMA_TEXT_MODEL=local
LLAMA_VISION_MODEL=local
LLAMA_EMBED_MODEL=local

# --- Full report ---
# How many parts of your documents are read at once. It only helps if
# llama-server has that many slots: set `parallel = 4` for the chat model in
# models.ini (or `--parallel 4`), then keep this at 3 so a chat can still be
# answered while a report runs. With `parallel = 1` leave it at 1.
REPORT_PARALLEL=3
# The most documents / characters one report reads, and how much of a
# document one note-taking call sees.
REPORT_MAX_FILES=15
REPORT_MAX_CHARS=300000
REPORT_BATCH_CHARS=12000

# GPU index (as shown by `nvidia-smi`) given to the Docling converter
# containers (celery-convert-fast / celery-convert-ocr). Pick one with free
# VRAM -- llama-server may already be using both GPUs.
DOC_GPU_ID=0
