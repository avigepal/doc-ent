\documentclass[11pt]{article}

% "Doc/Index" report template — gives pandoc's plain PDF export a styled
% title block, colored section rules, cited-source footer and page
% numbers, matching the dashboard's archive/index-card identity instead
% of pandoc's bare default look. Needs xelatex (fontspec) — see
% backend/Dockerfile's texlive-xetex + fonts-crosextra-carlito install.

\usepackage{fontspec}
\setmainfont{Carlito}
\setmonofont{DejaVu Sans Mono}[Scale=0.9]

\usepackage[a4paper,top=2.6cm,bottom=2.6cm,left=2.2cm,right=2.2cm]{geometry}
\usepackage{xcolor}
\definecolor{indexblue}{HTML}{2B3A67}
\definecolor{locatorbrown}{HTML}{A8681F}
\definecolor{inksoft}{HTML}{52555C}
\definecolor{linegray}{HTML}{D8D5CC}

\usepackage{titlesec}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{indexblue}}{}{0em}{}[{\color{linegray}\titlerule}]
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{indexblue}}{}{0em}{}
\titlespacing{\section}{0pt}{1.6em}{0.8em}
\titlespacing{\subsection}{0pt}{1.2em}{0.5em}

\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{inksoft}DOC/INDEX}
\fancyfoot[R]{\footnotesize\color{inksoft}\thepage}

\usepackage[colorlinks=true,linkcolor=indexblue,urlcolor=indexblue,citecolor=indexblue]{hyperref}
\usepackage{enumitem}
\setlist{itemsep=0.2em,topsep=0.3em}

\usepackage{fancyvrb}
\usepackage{framed}
\definecolor{shadecolor}{HTML}{F3E3CC}

\usepackage{parskip}
\setlength{\parskip}{0.6em}

$if(highlighting-macros)$
$highlighting-macros$
$endif$

\begin{document}

\begingroup
\color{indexblue}
\rule{\linewidth}{1.2pt}
\endgroup
\vspace{0.3em}

{\fontsize{22}{26}\selectfont\bfseries $title$}

\vspace{0.1em}
\textcolor{locatorbrown}{\large DOC/INDEX — INTELLIGENT REPORT}

$if(subtitle)$
\vspace{0.3em}

\textcolor{inksoft}{$subtitle$}
$endif$

\vspace{0.2em}
\textcolor{inksoft}{\footnotesize Generated $date$}

\vspace{0.4em}
\begingroup
\color{linegray}
\rule{\linewidth}{0.6pt}
\endgroup

\vspace{1.2em}

$body$

\end{document}
